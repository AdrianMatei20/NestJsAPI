# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Session secret (any long random string)
SECRET=

# Database (Postgres)
DB_TYPE=postgres
PG_HOST=localhost
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=postgres
PG_PORT=5432

# Redis (used for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Outgoing email (EmailJS - used for registration/password-reset emails)
EMAIL_JS_SERVICE_ID=
EMAIL_JS_TEMPLATE_ID=
EMAIL_JS_PUBLIC_KEY=
EMAIL_JS_PRIVATE_KEY=

# Seed data (see src/services/seed/seed.service.ts) - leave any of these blank to skip
# seeding that part. DEFAULT_PASSWORD is shared by the admin account, the default account,
# and every @test.com demo account.
ADMIN_USER_EMAIL=
DEFAULT_USER_EMAIL=
DEFAULT_USER_FIRSTNAME=
DEFAULT_USER_LASTNAME=
DEFAULT_PASSWORD=
